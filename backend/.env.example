# Porta local do servidor (o Render define a dele automaticamente via PORT)
PORT=3000

# ID da Planilha Google já CONVERTIDA (não é o .xlsx original).
# É o trecho entre /d/ e /edit no link da planilha:
# https://docs.google.com/spreadsheets/d/ESTE_TRECHO_AQUI/edit
# A planilha oficial deste projeto já está criada — veja o SPREADSHEET_ID no README.
SPREADSHEET_ID=1po82mv7df3rMDITPY-eOV9wSiqImO8Yj1XwShCW4Flg

# Chave secreta para assinar os tokens de login. Gere com: openssl rand -hex 32
JWT_SECRET=

# Origem permitida para chamadas do frontend (CORS). Em produção, a URL do GitHub Pages.
# Em desenvolvimento local, a URL onde você está servindo a pasta frontend/.
CORS_ORIGIN=http://localhost:5500

# Conteúdo do arquivo JSON da conta de serviço do Google Cloud, convertido para
# base64 em uma única linha. NUNCA cole o JSON aqui em texto puro, e NUNCA
# commite este arquivo preenchido — .env está no .gitignore.
# Como gerar o base64 (Linux/Mac): base64 -i caminho/para/chave.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
